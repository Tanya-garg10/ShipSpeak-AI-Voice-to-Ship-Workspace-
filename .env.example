# FEATHERLESS_API_KEY: Required for Featherless AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
FEATHERLESS_API_KEY="MY_FEATHERLESS_API_KEY"

# WISPRFLOW_API_KEY: Required for Wispr Flow voice dictation API calls.
# Get your API key from https://wisprflow.ai/account/api-keys
# If not provided, the app will fall back to browser's Web Speech API.
WISPRFLOW_API_KEY="MY_WISPRFLOW_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
